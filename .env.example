# Generate a dedicated random value; this protects Lariat's local HTTP endpoint.
LARIAT_API_KEY=replace-with-a-long-random-secret

LARIAT_HOST=127.0.0.1
LARIAT_PORT=5055
# Leave LARIAT_MODEL unset to use the authenticated Codex account default.
LARIAT_REASONING_EFFORT=medium
LARIAT_RUNNER=app-server
LARIAT_TIMEOUT_SECONDS=180
LARIAT_MAX_QUEUE=32
LARIAT_MAX_PROMPT_CHARS=250000
LARIAT_RECYCLE_REQUESTS=50
LARIAT_RECYCLE_SECONDS=21600
LARIAT_TELEMETRY_CACHE_SECONDS=60
